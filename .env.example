# Public URL of the deployed site, without a trailing slash.
# Used for canonical/Open Graph URLs, sitemap.xml and the Sitemap line in robots.txt.
# Leave empty to skip the absolute URLs (the site still works).
VITE_SITE_URL=

# Base path the site is served from. Use "/" for Vercel, Netlify or a custom domain.
# For a GitHub Pages project site (https://<user>.github.io/<repo>/) use "/<repo>/".
VITE_BASE_PATH=/
